# Copy to .env and fill in. .env is git-ignored; never commit it.
ANTHROPIC_API_KEY=
# or, with INTAKE_LLM_PROVIDER=openrouter:
OPENROUTER_API_KEY=

# Optional overrides (defaults in src/intake/config.py)
# INTAKE_LLM_PROVIDER=anthropic       # or openrouter
# INTAKE_LLM_MODEL=claude-sonnet-5-5   # OpenRouter: anthropic/claude-sonnet-5.5
# INTAKE_LLM_OFFLINE=0
# INTAKE_CONFIDENCE_THRESHOLD=0.9

# Guardrails, off by default (turn on in the pilot, see docs/rollout-plan.md)
# INTAKE_MAX_AUTO_AMOUNT=10000         # above this gross amount: always a person
# INTAKE_REVIEW_NEW_SUPPLIERS=1        # new sellers and changed IBANs: always a person
